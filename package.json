{
  "name": "tellink-chatbot",
  "version": "1.0.0",
  "description": "TelLink AI-powered customer support chatbot with Agent Router",
  "main": "server.js",
  "homepage": "https://comradeonboard.github.io/agentrouter-chatbot",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "init-db": "node database/setup.js",
    "install-all": "npm install && cd src/web && npm install && cd ../mobile && npm install",
    "build": "cd src/web && npm run build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d src/web/dist"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^4.52.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
